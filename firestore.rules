rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ["theerrv@gmail.com", "nallathanadakum@gmail.com"];
    }

    function isFormCollection(collectionName) {
      return collectionName in [
        "assistanceRequests",
        "volunteerApplications",
        "speakerInvitations",
        "contactMessages",
        "donationPledges"
      ];
    }

    match /{collectionName}/{documentId} {
      allow create: if isFormCollection(collectionName);
      allow read: if isFormCollection(collectionName) && isAdmin();
      allow update, delete: if false;
    }
  }
}
